{
  "expo": {
    "name": "AB Academy",
    "slug": "ab-academy-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "abacademy",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.abacademy.app"
    },
    "android": {
      "package": "com.abacademy.app"
    },
    "web": {
      "bundler": "metro"
    }
  }
}